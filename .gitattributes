# ═══════════════════════════════════════════════════════════════
#  git על ווינדוס ממיר שורות ל-CRLF. לסקריפטים שרצים על לינוקס
#  זה קטלני: bash נופל עם "bad interpreter: /usr/bin/env bash^M".
#  כאן קובעים LF בכל מקרה, לכל מי שיעבוד על הריפו.
# ═══════════════════════════════════════════════════════════════

* text=auto eol=lf

*.sh   text eol=lf
*.conf text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# PowerShell 5.1 on Windows: keep CRLF and the UTF-8 BOM.
# Without the BOM it reads .ps1 as ANSI and mangles any non-ASCII byte.
*.ps1  text eol=crlf

*.woff2 binary
*.png   binary
*.jpg   binary
*.webp  binary
*.ico   binary
